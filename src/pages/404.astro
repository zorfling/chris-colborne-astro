---
import Base from '../layouts/Base.astro';
---

<Base
  title="Page not found - Chris Colborne"
  description="Sorry, that page doesn't exist. Head back to the homepage or browse the blog."
>
  <main>
    <section class="hero">
      <div class="wrap">
        <p class="eyebrow">404</p>
        <h1>Page not found</h1>
        <p class="lede">
          Sorry, that page doesn't exist (or it moved when the site did). Try the
          <a href="/">homepage</a> or the <a href="/blog/">blog</a>.
        </p>
      </div>
    </section>
  </main>
</Base>
